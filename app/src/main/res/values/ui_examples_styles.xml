<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.ItgTools.UiExampleCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="cardBackgroundColor">@color/home_card_background</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="rippleColor">@color/home_card_ripple</item>
        <item name="strokeColor">@color/home_card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="ItgToolsUiExampleCardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:drawableEnd">@drawable/ic_ui_example_arrow</item>
        <item name="android:drawableTint">@color/home_accent</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textColor">@color/home_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ItgToolsUiExampleSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/home_text_primary</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ItgToolsUiExampleSectionDescription">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/home_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
