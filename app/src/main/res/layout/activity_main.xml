<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <ScrollView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/home_background"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        tools:context=".MainActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/home_hero_background"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/home_hero_label_background"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/home_eyebrow"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/home_hero_title"
                    android:textColor="@android:color/white"
                    android:textSize="29sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/home_hero_description"
                    android:textColor="@color/home_hero_description"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/home_section_title"
                android:textColor="@color/home_text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="@string/home_section_description"
                android:textColor="@color/home_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/openItgUiExamples"
                style="@style/Widget.ItgTools.HomeCard">

                <LinearLayout style="@style/ItgToolsHomeCardContent">
                    <TextView
                        style="@style/ItgToolsHomeCardNumber"
                        android:text="@string/home_card_number_ui" />

                    <LinearLayout style="@style/ItgToolsHomeCardTextGroup">
                        <TextView
                            style="@style/ItgToolsHomeCardTitle"
                            android:text="@string/home_ui_title" />
                        <TextView
                            style="@style/ItgToolsHomeCardDescription"
                            android:text="@string/home_ui_description" />
                    </LinearLayout>

                    <TextView style="@style/ItgToolsHomeCardArrow" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/openDialogQueueDemo"
                style="@style/Widget.ItgTools.HomeCard"
                android:layout_marginTop="12dp">

                <LinearLayout style="@style/ItgToolsHomeCardContent">
                    <TextView
                        style="@style/ItgToolsHomeCardNumber"
                        android:text="@string/home_card_number_dialog" />

                    <LinearLayout style="@style/ItgToolsHomeCardTextGroup">
                        <TextView
                            style="@style/ItgToolsHomeCardTitle"
                            android:text="@string/home_dialog_title" />
                        <TextView
                            style="@style/ItgToolsHomeCardDescription"
                            android:text="@string/home_dialog_description" />
                    </LinearLayout>

                    <TextView style="@style/ItgToolsHomeCardArrow" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/openMatrixTraceDemo"
                style="@style/Widget.ItgTools.HomeCard"
                android:layout_marginTop="12dp">

                <LinearLayout style="@style/ItgToolsHomeCardContent">
                    <TextView
                        style="@style/ItgToolsHomeCardNumber"
                        android:text="@string/home_card_number_matrix" />

                    <LinearLayout style="@style/ItgToolsHomeCardTextGroup">
                        <TextView
                            style="@style/ItgToolsHomeCardTitle"
                            android:text="@string/home_matrix_title" />
                        <TextView
                            style="@style/ItgToolsHomeCardDescription"
                            android:text="@string/home_matrix_description" />
                    </LinearLayout>

                    <TextView style="@style/ItgToolsHomeCardArrow" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</layout>
