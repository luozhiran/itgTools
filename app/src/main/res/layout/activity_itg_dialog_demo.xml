<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="弹窗队列演示"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="批量入队后，优先级高的先弹出。关闭当前弹窗后才会展示下一条。广告由第一个消费者处理，通知由兜底消费者处理；一次性消息无人处理则丢弃。"
            android:textSize="14sp" />

        <Button
            android:id="@+id/enqueueBatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="批量入队：普通、紧急、活动" />

        <Button
            android:id="@+id/enqueueUrgent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="新增最高优先级通知" />

        <Button
            android:id="@+id/enqueueNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="新增需兜底处理的通知" />

        <Button
            android:id="@+id/enqueueOnce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="发送一次（无消费者则丢弃）" />

        <Button
            android:id="@+id/enqueueFromThread"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="模拟后台线程入队" />

        <Button
            android:id="@+id/toggleFallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="停用兜底消费者" />

        <Button
            android:id="@+id/retryPending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="重试等待队列" />

        <TextView
            android:id="@+id/showingState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pendingState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="最近事件"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/eventLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
