<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable name="item" type="com.itg.itgtools.pages.itgui.RecyclerDataRow" />
        <variable name="actions" type="com.itg.itgtools.pages.itgui.RecyclerDemoActions" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:background="#FFE8F5E9"
        android:onClick="@{() -> actions.onDataClick(item.stableId)}"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@{item.title}" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DataBinding 自动设置 item / actions / lifecycleOwner" />
    </LinearLayout>
</layout>
