<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Web Cache Demo"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/webCacheUrlEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="https://www.example.com/"
            android:inputType="textUri"
            android:singleLine="true" />

        <Switch
            android:id="@+id/webCachePreloadSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable preload" />

        <Switch
            android:id="@+id/webCacheContainerSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable container cache policy" />

        <Switch
            android:id="@+id/webCacheForceOverrideSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Force override container cacheMode" />

        <Switch
            android:id="@+id/webCacheBusinessNoCacheSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preset business LOAD_NO_CACHE" />

        <Switch
            android:id="@+id/webCacheParallelSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable parallel preload (max 2)" />

        <Switch
            android:id="@+id/webCacheKillSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kill switch" />

        <Button
            android:id="@+id/webCacheStartPreloadButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Start preload" />

        <Button
            android:id="@+id/webCacheOpenButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open WebView container" />

        <Button
            android:id="@+id/webCacheCancelButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel preload" />

        <Button
            android:id="@+id/webCacheClearHttpButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear WebView HTTP cache" />

        <Button
            android:id="@+id/webCacheClearLogButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear event log" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Events"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/webCacheLogScroll"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="8dp"
            android:background="#111111"
            android:padding="8dp">

            <TextView
                android:id="@+id/webCacheLogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No events yet."
                android:textColor="#EEEEEE"
                android:textSize="12sp" />
        </ScrollView>
    </LinearLayout>
</ScrollView>